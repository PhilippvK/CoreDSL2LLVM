// RUN: pattern-gen %s -O 3 --no-extend --mattr=+m,+gpr32v --riscv-xlen 32 | FileCheck --check-prefixes=CHECK-RV32,CHECK-RV32-NOEXTED -allow-unused-prefixes %s

